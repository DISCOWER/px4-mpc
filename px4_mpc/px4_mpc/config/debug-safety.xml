 <customMathEquations>
  <snippet language="PYTHON" name="airspeed_safety_colors">
   <global></global>
   <function>import math

v_odom = math.sqrt(v3**2+v4**2+v5**2)
code=0
shield = value == 1
solve_fail = v2!=0
safe = v_odom&gt;10

# Code 1: shield does its job properly
if shield and safe: code = 1 # yellow
# Code 2: shield failed
if shield and not safe: code = 2 # red
# Code 3: shield didn't trigger
if not shield and not safe: code = 3 # pink
# Code 4: minor solver failure
if solve_fail and safe and shield: code = 4 # orange 
# Code 5: major solver failure
if solve_fail and not safe and shield: code = -1 # black

return code</function>
